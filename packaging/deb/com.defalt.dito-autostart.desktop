[Desktop Entry]
Type=Application
Version=1.0
Name=Dito (ditado por voz)
Comment=Deixa o ditado pronto em segundo plano, sem abrir janela
# `listen` is the headless daemon: hotkeys, recording, transcription and paste, no window at all.
# Requirement from the owner, in his words: "não quero que quando eu ligo o PC ele já fica
# aparecendo". Nothing is drawn at login.
#
# DITO_BOOTSTRAP=never is load-bearing. On a machine where the app was installed but never
# opened, the user venv does not exist yet; without this the launcher would start downloading
# wheels at login, behind the user's back and with no window to show progress. With it, the
# daemon exits quietly and waits for the first manual launch from the menu.
Exec=env DITO_BOOTSTRAP=never /usr/bin/dito listen
Icon=com.defalt.dito
Terminal=false
# NoDisplay is deliberately absent. This file lives in /etc/xdg/autostart, which no application
# menu ever reads, so hiding it would buy nothing -- and it WOULD hide the entry from the
# session's "Startup Applications" screen, which is exactly where the user is supposed to be able
# to turn the daemon off without editing files under /etc as root.
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Applications
