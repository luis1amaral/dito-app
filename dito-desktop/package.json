{
  "name": "dito",
  "version": "2.0.0",
  "private": true,
  "description": "Ditado por voz - aperte F9, fale, o texto aparece onde o cursor esta",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "engine": "node quality/engine.mjs",
    "mutation": "node quality/mutation.mjs",
    "native": "node quality/native.mjs",
    "verify": "pwsh -NoProfile -File quality/verify.ps1",
    "pack": "electron-builder --win --publish never"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "sherpa-onnx-node": "^1.13.6"
  },
  "productName": "Dito",
  "author": "Luis Amaral",
  "license": "MIT",
  "build": {
    "appId": "com.luisamaral.dito",
    "productName": "Dito",
    "artifactName": "dito-${version}-setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "native/build/Release/dito_win32.node",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "native/build/Release/dito_win32.node",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "win": {
      "icon": "assets/dito.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dito",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luis1amaral",
        "repo": "dito-app"
      }
    ]
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "electron": "^43.4.1",
    "node-gyp": "^12.4.0"
  }
}
